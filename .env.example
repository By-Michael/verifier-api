PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# ---- REQUIRED — server will not boot without this ----
# MySQL connection string (Prisma). See prisma/schema.prisma.
DATABASE_URL=mysql://user:password@host:3306/dbname

# ---- Optional — webhooks/notifications only (BullMQ queues) ----
# Core verification endpoints (/verify-cbe, /verify-telebirr, /verify,
# etc.) work fine without this. Previously the server crashed on boot
# entirely if this was unset — fixed to degrade gracefully instead.
# REDIS_URL=redis://user:password@host:6379

# ---- Optional — only needed for POST /verify-image ----
# Get a key at https://mistral.ai/
# MISTRAL_API_KEY=your_mistral_api_key

# ---- Optional — admin/dashboard endpoints ----
# ADMIN_SECRET=replace_with_a_long_random_secret
# DASHBOARD_SECRET=replace_with_a_different_long_random_secret

# ---- Optional — CBE "new" (mb.cbe.com.et) verification path ----
# Only override if CBE changes their public app registration; the code
# ships with working defaults.
# CBE_APP_ID=d1292e42-7400-49de-a2d3-9731caa4c819
# CBE_APP_VERSION=0a01980b-9859-1369-8198-59f403820000

# ---- Optional — Telebirr proxy/relay tuning ----
# Set to true to bypass the primary fetch path during testing.
SKIP_PRIMARY_VERIFICATION=false
# Comma-separated relay URLs used as Telebirr fallbacks.
# FALLBACK_PROXIES=https://example.et/telebirr?reference=,https://relay.example/telebirr?reference=
# TELEBIRR_PROXY_KEY=your_proxy_key
# Optional public labels shown for the relays above, same order (raw URLs
# are never exposed to callers).
# TELEBIRR_PROXY_LABELS=leul.et,Community relay 1
TELEBIRR_PROXY_TIMEOUT_MS=18000
TELEBIRR_HEDGE_DELAY_MS=1000
TELEBIRR_PROXY_COOLDOWN_MS=60000
TELEBIRR_PROXY_FAILURE_THRESHOLD=2
TELEBIRR_MAX_PARALLEL_PROXIES=2
TELEBIRR_TOTAL_TIMEOUT_MS=20000

# ---- Optional — status-probe monitoring (internal health dashboard) ----
# STATUS_MONITOR_SECRET=replace_with_a_long_random_secret
# STATUS_PROBE_TELEBIRR_REFERENCE=
STATUS_PROBE_TELEBIRR_PROXY_TIMEOUT_MS=18000
# STATUS_PROBE_CBE_LEGACY_REFERENCE=
# STATUS_PROBE_CBE_LEGACY_ACCOUNT_SUFFIX=
# STATUS_PROBE_CBE_NEW_URL=
# STATUS_PROBE_CBEBIRR_REFERENCE=
# STATUS_PROBE_CBEBIRR_PHONE=
# STATUS_PROBE_DASHEN_REFERENCE=
# STATUS_PROBE_ABYSSINIA_REFERENCE=
# STATUS_PROBE_ABYSSINIA_ACCOUNT_SUFFIX=

# ---- Optional — outbound notification email (buyer purchase receipts) ----
# RESEND_API_KEY=
# VERITAS_NOTIFICATIONS_FROM_EMAIL=
# VERITAS_APP_URL=
# VERITAS_PRO_PRICE=
# VERITAS_BUSINESS_PRICE=

# ---- Optional — third-party proxy keys ----
# MPESA_PROXY_KEY=
# TELEGRAM_BOT_TOKEN=

# ---- Optional — queue worker concurrency (only relevant if REDIS_URL set) ----
WEBHOOK_QUEUE_CONCURRENCY=5
NOTIFICATION_QUEUE_CONCURRENCY=5

# ---- Puppeteer (CBE-legacy verification fallback) ----
# Only relevant for local/non-Docker runs. The provided Dockerfile already
# sets these correctly for you — see comments there for why (Ubuntu's apt
# "chromium" package is a non-functional Snap stub in Docker).
# PUPPETEER_CACHE_DIR=./.cache/puppeteer
# PUPPETEER_EXECUTABLE_PATH=
